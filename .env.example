# 复制为 .env 后按需修改（docker compose 会自动读取同目录的 .env）
# cp .env.example .env

# Web 访问端口（宿主机）
# 修改 docker-compose.yml 里的 ports 映射即可，这里仅作说明

# 用于加密用户绑定的 API Key。留空会自动生成并保存到 ./data/app-secret
# 注意：更换该值会导致已绑定的 API Key 无法解密（需要用户重新绑定）
APP_SECRET=

# 服务器默认 API Key：账号没有绑定自己的 Key 时会使用它。
# 适合“一个人付费、几个人共用”的场景；留空则每个账号必须自己绑定 Key。
DEFAULT_DEEPSEEK_API_KEY=

# 是否允许注册（true/false）
ALLOW_REGISTRATION=true

# 注册邀请码：非空时注册必须填写，适合只给熟人使用
REGISTER_INVITE_CODE=

# 登录态有效天数
SESSION_DAYS=30

# 通过 HTTPS 反向代理访问时设为 true
COOKIE_SECURE=false
TRUST_PROXY=false

# ---------- 构建镜像用（国内默认走 npmmirror，海外可改回官方源） ----------
# npm 源；想用官方源：https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com
# 基础镜像；国内 Docker Hub 拉取慢时可换成镜像仓库，例如：
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-bookworm-slim
NODE_IMAGE=node:24-bookworm-slim
